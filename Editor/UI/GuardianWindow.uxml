<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Packages/com.resenha.guardian/Editor/UI/GuardianWindow.uss?fileID=7433441132597879392&amp;guid=26418bbe3921ae8faafac18a828d766d&amp;type=3#GuardianWindow"/>
    <ui:VisualElement class="guardian-root">
        <ui:VisualElement class="guardian-header">
            <ui:VisualElement class="guardian-brand">
                <ui:Label name="header-title" text="Guardian" class="guardian-title"/>
                <ui:Label name="header-subtitle" text="Project Integrity &amp; Quality Auditor" class="guardian-subtitle"/>
            </ui:VisualElement>
            <ui:VisualElement class="guardian-header-actions">
                <ui:DropdownField name="lang-dropdown" tooltip="Select Editor Display Language" class="guardian-lang-dropdown"/>
                <ui:Button name="btn-view-diagram" text="View Diagram" tooltip="Open interactive Pan &amp; Zoom dependency diagram in browser" class="guardian-btn-secondary"/>
                <ui:Button name="btn-copy-mermaid" text="Copy Mermaid" tooltip="Copy Mermaid.js diagram code to clipboard" class="guardian-btn-secondary"/>
                <ui:Button name="btn-copy-report" text="Copy Report" tooltip="Copy complete Markdown report to clipboard (ideal for AI or team review)" class="guardian-btn-secondary"/>
                <ui:Button name="btn-scan" text="Scan Project" tooltip="Run local on-demand audit across scripts, prefabs, and UI." class="guardian-btn-scan"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="guardian-score-card">
            <ui:VisualElement class="guardian-score-left">
                <ui:Label name="grade-badge" text="A+" tooltip="Health grade based on detected project issues." class="guardian-grade-badge"/>
                <ui:VisualElement class="guardian-score-details">
                    <ui:Label name="score-title" text="100% Health Score" class="guardian-score-title"/>
                    <ui:Label name="score-summary" text="0 issues detected" class="guardian-score-sub"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="guardian-score-right">
                <ui:Label name="stat-duration" text="Ready to scan" class="guardian-stat-time"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="guardian-filter-bar">
            <ui:Button name="filter-all" text="All (0)" tooltip="Show all audit results" class="guardian-chip active" style="border-top-left-radius: 3px; border-top-right-radius: 3px; border-bottom-right-radius: 3px; border-bottom-left-radius: 3px;"/>
            <ui:Button name="filter-critical" text="Critical (0)" tooltip="Filter critical build/runtime-breaking issues" class="guardian-chip" style="border-top-left-radius: 3px; border-top-right-radius: 3px; border-bottom-right-radius: 3px; border-bottom-left-radius: 3px;"/>
            <ui:Button name="filter-warnings" text="Warnings (0)" tooltip="Filter performance &amp; anti-pattern issues" class="guardian-chip" style="border-top-left-radius: 3px; border-top-right-radius: 3px; border-bottom-right-radius: 3px; border-bottom-left-radius: 3px;"/>
            <ui:Button name="filter-suggestions" text="Suggestions (0)" tooltip="Filter localization &amp; style recommendations" class="guardian-chip" style="border-top-left-radius: 3px; border-top-right-radius: 3px; border-bottom-right-radius: 3px; border-bottom-left-radius: 3px;"/>
        </ui:VisualElement>
        <ui:ScrollView name="issues-scrollview" class="guardian-list-container">
            <ui:VisualElement name="empty-state" class="guardian-empty-state">
                <ui:Label name="empty-state-text" text="No issues found! Project is clean and robust." class="guardian-empty-text"/>
            </ui:VisualElement>
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
